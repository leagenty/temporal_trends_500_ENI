# 2. Open datasets

```{r}
coleo_tot <- read.csv("2.temporal_morphogroups/input/coleo_year.csv") %>% 
  mutate(id_parcelle=as.character(id_parcelle))

plots_plus_sept <- coleo_tot %>% 
  select(id_parcelle,annee) %>% 
  distinct() %>% 
  group_by(id_parcelle) %>% 
  mutate(nbre_annee= n_distinct(annee)) %>% 
  select(id_parcelle,nbre_annee) %>% 
  distinct() %>% 
  filter(nbre_annee > 7)

coleo_year <- coleo_tot %>% 
  filter(id_parcelle %in% plots_plus_sept$id_parcelle) 
summary(coleo_year)
write.csv(coleo_year,"2.temporal_morphogroups/output/coleo_year.csv")


crop <- read_delim("2.temporal_morphogroups/input/region_and_crop_type.csv") %>%
  mutate(crop=TypeCulture,
         crop=as.factor(crop),
         id_parcelle=as.character(id_parcelle))

overdisp_fun <- function(model) {
  rdf <- df.residual(model)
  rp <- residuals(model, type = "pearson")
  Pearson.chisq <- sum(rp^2)
  prat <- Pearson.chisq / rdf
  pval <- pchisq(Pearson.chisq, df = rdf, lower.tail = FALSE)
  c(chisq = Pearson.chisq, ratio = prat, rdf = rdf, p = pval)
}

```

# 3. Ab morphogroups

## 3.1. Bruches

```{r}
mod <- glmmTMB(Bruches ~ annee + (1 | id_parcelle), family = nbinom2, data = coleo_year)

sim_res <- simulateResiduals(mod, n = 1000)
plot(sim_res)
testDispersion(sim_res)
testZeroInflation(sim_res)

summary(mod)
Anova(mod)
```

effet pos annee 0.03 \*\*\*

Pour avoir IRR, facteurs multiplicatifs :

```{r}
coefs <- summary(mod)$coefficients$cond
IRR <- exp(coefs[, "Estimate"])
lower <- exp(coefs[, "Estimate"] - 1.96 * coefs[, "Std. Error"])
upper <- exp(coefs[, "Estimate"] + 1.96 * coefs[, "Std. Error"])
IRR_table_Bruches <- data.frame(
  Term = rownames(coefs),
  IRR = IRR,
  CI_lower = lower,
  CI_upper = upper
)
IRR_table_Bruches
```

annee : IRR = 1.03 → +1 année → espérance de Bruches × 1.03 (+3%)

```{r}
newdat <- data.frame(
  annee = sort(unique(coleo_year$annee))
)

p <- predict(
  mod,
  newdata = newdat,
  type = "response",
  se.fit = TRUE,
  re.form = NA     # prédiction population-level
)

# Conversion sûre (évite le bug vec_slice)
fit <- drop(p$fit)
se  <- drop(p$se.fit)

newdat$fit <- fit
newdat$lwr <- fit - 1.96 * se
newdat$upr <- fit + 1.96 * se

breaks_y <- c(seq(0, 100, by = 20), seq(200, max(coleo_year$Bruches), by = 100))

ggplot(coleo_year, aes(x = annee, y = Bruches)) +
  #geom_boxplot(aes(group = annee),
          #     notch=T,
           #    notchwidth = 0.4,
            #   fill="lightgrey",
             #  alpha=0.3
                # ) +
   geom_jitter(height = 0.1,width=0.2,col="lightgrey") +
  geom_line(
    data = newdat,
    aes(x = annee, y = fit),
    linewidth = 1.2,
    color = "aquamarine3",
    inherit.aes = FALSE
  ) +

  geom_ribbon(
    data = newdat,
    aes(x = annee, ymin = lwr, ymax = upr),
    fill = "aquamarine3",
    alpha = 0.2,
    inherit.aes = FALSE
  ) +

  scale_x_continuous(breaks = unique(coleo_year$annee)) +
  labs(
    x = "Year",
    y = "Seed beetle abundance (log scale)"
  ) +
  theme_minimal() +
  scale_y_continuous(trans='log1p',
                       breaks = breaks_y  )



```

