# 1. Open dataset

```{r}
library(tidyverse)
library(FactoMineR)
library(lubridate)
library(factoextra)
library(corrplot)
library(lme4)
library(MuMIn)
library(MASS)
library(AICcmodavg)
library(car)
library(ggpubr)
select <- dplyr::select

plant_ind<- read.csv(file="3.glmm_morphogroups_plant_traits/3.3.relations_coleo_morphogroups_plant_traits/input/plants_indicators_per_year_and_field.csv") %>% 
  select(-X) 

morphog <- read.csv(file="3.glmm_morphogroups_plant_traits/3.3.relations_coleo_morphogroups_plant_traits/input/morphog_wide.csv") %>% 
  select(-X) 
```

# 2. Pool data

```{r}
plant_coleo <- morphog %>% 
  left_join(plant_ind) 

ou_na <- plant_coleo %>%
  summarise(across(everything(), ~ sum(is.na(.)))) %>%
  pivot_longer(everything(), names_to = "column", values_to = "na_count")

plant_coleo <-plant_coleo %>% 
  filter(!is.na(CWM_white))
```

# 3. Models

## 3.1. Bruches

```{r}
mod <- lmer(Bruches~ ab_pl + rich_sp_pl + CWM_height_max + CWM_flow_on + CWM_perennial + CWM_pollmode + CWM_EIV_N+ (1| id_parcelle)  , data=plant_coleo, REML=F, na.action="na.fail")
vif(mod)
dredge(mod)

mod_best <- lmer(Bruches~ rich_sp_pl + CWM_perennial +  CWM_EIV_N + CWM_flow_on + (1| id_parcelle)  , data=plant_coleo, REML=T, na.action="na.fail")
summary(mod_best)
Anova(mod_best)
r.squaredGLMM(mod_best)
```

Fixed effects:
              Estimate Std. Error t value
