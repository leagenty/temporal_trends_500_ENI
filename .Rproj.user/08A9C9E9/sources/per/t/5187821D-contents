# 2. GLMM : agri practices impacts on coleo groups

## 2.1. Bruches

```{r}
mod <- lmer(Bruches~ Bordure_Largeur + Bordure_NombreInterventionYEAR + IFT_Insecticide2013_2019 + CoefN + TypeCulture+ (1| id_parcelle)  , data=morpho_agri, REML=F, na.action="na.fail")
vif(mod)
dredge(mod)

mod_best <- lmer(Bruches~ Bordure_Largeur + TypeCulture + (1| id_parcelle)  , data=morpho_agri, REML=T, na.action="na.fail")


summary(mod_best)
Anova(mod_best)
r.squaredGLMM(mod_best)
```

