# 1. Open data

```{r}
select <- dplyr::select
library(tidyverse)
library(lattice)
library(lme4)
library(lubridate)
library(DHARMa)
library(glmmTMB)
library(car)
library(broom.mixed)  

overdisp_fun <- function(model) {
  rdf <- df.residual(model)
  rp <- residuals(model, type = "pearson")
  Pearson.chisq <- sum(rp^2)
  prat <- Pearson.chisq / rdf
  pval <- pchisq(Pearson.chisq, df = rdf, lower.tail = FALSE)
  c(chisq = Pearson.chisq, ratio = prat, rdf = rdf, p = pval)
}

crop <- read.csv(file="8.plant_species/input/region_and_crop_type.csv",sep=";")%>% 
  mutate(id_parcelle=as.factor(id_parcelle)) %>% 
  rename(crop=TypeCulture)

plants_tot <- read.csv(file="8.plant_species/input/flore_long2025.csv",sep=";") %>% 
  mutate(id_parcelle=as.factor(id_parcelle)) %>% 
  left_join(crop) 

plots_plus_sept <- plants_tot %>% 
  select(id_parcelle,annee) %>% 
  distinct() %>% 
  group_by(id_parcelle) %>% 
  mutate(nbre_annee= n_distinct(annee)) %>% 
  select(id_parcelle,nbre_annee) %>% 
  distinct() %>% 
  filter(nbre_annee > 7)

plants_sp_year <- plants_tot %>% 
  filter(id_parcelle %in% plots_plus_sept$id_parcelle) 
```

