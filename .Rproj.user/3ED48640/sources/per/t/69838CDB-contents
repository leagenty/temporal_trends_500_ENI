# 3. Dynamic of abundance of each species
```{r}
plants_sp_year_wide <- plants_sp_year %>%
  mutate(
    nom.eni = str_replace_all(nom.eni, " ", "_") %>%
              str_replace_all("\\.", "")
  ) %>% 
  pivot_wider(names_from = nom.eni,
              values_from = ab_pl,
              values_fill= 0)
```

