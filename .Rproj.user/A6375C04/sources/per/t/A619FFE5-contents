## 3.1.Arrhenatherum_elatius_subsp_elatius

```{r}
mod <- glmmTMB(Arrhenatherum_elatius_subsp_elatius ~ annee + (1| id_parcelle) , data=plants_sp_year_wide,family=nbinom1)

sim_res <- simulateResiduals(mod, n = 1000)
plot(sim_res)
testDispersion(sim_res) # dispersion en dessous de 1, sous-disp
overdisp_fun(mod) #still under 1, so still kind of ok
testZeroInflation(sim_res) # not ok

y <- plants_sp_year_wide$Arrhenatherum_elatius_subsp_elatius
c(
  zeros_observes = sum(y == 0),
  proportion_zeros = mean(y == 0),
  total_observations = length(y)
)

# Nombre de zéros attendu sous le modèle ajusté vs ce qu'on trouve
sim <- simulate(mod, nsim = 1000)
zeros_simules <- vapply(
  sim,
  function(x) sum(x == 0),
  numeric(1)
)

c(
  zeros_observes = sum(y == 0),
  zeros_simules_moyenne = mean(zeros_simules),
  zeros_simules_min = min(zeros_simules),
  zeros_simules_max = max(zeros_simules)
)


mod_zi <- glmmTMB(Arrhenatherum_elatius_subsp_elatius ~ annee + (1| id_parcelle) , data=plants_sp_year_wide,family=nbinom1, ziformula = ~1)
#ne converge pas

diag_parcelle <- plants_sp_year_wide %>%
  group_by(id_parcelle) %>%
  summarise(
    n_obs = n(),
    n_zeros = sum(
      Arrhenatherum_elatius_subsp_elatius == 0,
      na.rm = TRUE
    ),
    toujours_zero = all(
      Arrhenatherum_elatius_subsp_elatius == 0,
      na.rm = TRUE
    ),
    .groups = "drop"
  )
table(diag_parcelle$n_obs)
table(diag_parcelle$toujours_zero)
sum(diag_parcelle$toujours_zero)

not_zero <- diag_parcelle |> 
  filter(toujours_zero == FALSE) |> 
  select(id_parcelle)
```

On a un souci de sous-dispersion, que signifie la sous-dispersion ?
Une statistique DHARMa inférieure à 1 indique que les résidus sont moins dispersés que prévu par les simulations du modèle. Cela peut notamment provenir :
- d'une structure temporelle ou spatiale non prise en compte ;
- d'une structure de comptage différente de celle supposée ;
- d'une hétérogénéité des données que le modèle représente mal.

Le modèle avec inflation de zéro ne converge pas quand on met un effet aléatoire.
Cela est du au fait que certaines parcelles sont toujours à zéro pour cette espèce : je vais donc éliminer les parcelles desquelles cette espèce est constamment absente. 

```{r}
plants_sp_year_wide_mod <- plants_sp_year_wide |> 
  filter(id_parcelle %in% not_zero$id_parcelle)
  
  
mod_no_zero <- glmmTMB(Arrhenatherum_elatius_subsp_elatius ~ annee + (1| id_parcelle) , data=plants_sp_year_wide_mod,family=nbinom1)

sim_res <- simulateResiduals(mod, n = 1000)
plot(sim_res)
testDispersion(sim_res) # dispersion en dessous de 1, sous-disp
overdisp_fun(mod) #still under 1, so still kind of ok
testZeroInflation(sim_res) # not ok

mod_zi <- glmmTMB(Arrhenatherum_elatius_subsp_elatius ~ annee + (1| id_parcelle) , data=plants_sp_year_wide_mod,family=nbinom1, ziformula = ~1) # ne converge toujours pas

summary(mod)
summary(mod_no_zero) 
AIC(mod)
AIC(mod_no_zero)
r2(mod)
r2(mod_no_zero)
```
En fait les résultats sont similaires entre le modèle avec et sans les parcelles toujours à zéro, le modèle ne doit déjà pas les prendre en compte. Le R2 augmente en revanche, car du bruit a été supprimé ? 

Je garde le modèle sans zéro enflé + sans les plots à 0 tous les ans et avec loi binomiale 1 car variance augmente avec la moyenne
```{r}
mod <- glmmTMB(Arrhenatherum_elatius_subsp_elatius ~ annee + (1| id_parcelle) , data=plants_sp_year_wide_mod,family=nbinom1)

summary(mod)
r2(mod)
```
0.039 ***
R2c : 0.858
r2m : 0.005


