```{r}
coleo_z <- coleo_long %>% 
  group_by(morphog) %>% 
  mutate(nb_z = sum(ab == 0, na.rm = TRUE),
         nb_occ = sum(ab >0,na.rm= T),
         sum=n(),
         sites_z = nb_z/sum) %>% 
  select(morphog,sites_z) %>% 
  distinct()
