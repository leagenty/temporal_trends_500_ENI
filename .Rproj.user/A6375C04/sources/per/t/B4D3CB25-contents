coleo_recap <- coleo_long %>% 
  mutate(occ=ifelse(ab==0,0,1)) %>% 
   group_by(morphog) %>% 
  mutate(ab_morphog=sum(ab),
         mean_ab_morphog = mean(ab),
         occ_prev=sum(occ),
         sum=n(),
         prev=occ_prev/sum
         ) %>% 
  ungroup() %>% 
  select(-year,-id_parcelle,-ab,-occ,-occ_prev,-sum) %>% 
  distinct()
