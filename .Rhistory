prat <-  coleo_tot %>%
select(1:20,TypeCulture,nbre_interv,CoefN,nbre_pesticides) %>%
filter(!is.na(nbre_pesticides),
!is.na(nbre_interv),
!is.na(CoefN)) %>%
group_by(id_parcelle) %>%
mutate(nbre_annee= n_distinct(annee)) %>%
filter(nbre_annee>7)
mod_pois <- glmer(
nbre_interv ~ year + (1 | id_parcelle),
family = poisson(link = "log"),
data = coleo_agri
)
# Diagnostics de convergence
summary(mod_pois)
isSingular(mod_pois)
VarCorr(mod_pois)
# Diagnostics des résidus
res <- simulateResiduals(mod_pois)
plot(res)
testDispersion(res)
testZeroInflation(res)
coleo_agri$year_c <- as.numeric(
scale(coleo_agri$year, center = TRUE, scale = FALSE)
)
mod_pois2 <- glmer(
nbre_interv ~ year_c + (1 | id_parcelle),
family = poisson(link = "log"),
data = coleo_agri,
control = glmerControl(
optimizer = "bobyqa",
optCtrl = list(maxfun = 200000)
)
)
summary(mod_pois2)
res2 <- simulateResiduals(mod_pois2)
plot(res2)
testDispersion(res2)
testZeroInflation(res2)
# Distribution des nombres de tontes
table(coleo_agri$nbre_interv, useNA = "ifany")
# Statistiques descriptives
summary(coleo_agri$nbre_interv)
mean(coleo_agri$nbre_interv, na.rm = TRUE)
var(coleo_agri$nbre_interv, na.rm = TRUE)
# Nombre d'années observées par parcelle
summary(table(coleo_agri$id_parcelle))
# Nombre d'observations par année
table(coleo_agri$year)
# Nombre de parcelles distinctes
length(unique(coleo_agri$id_parcelle))
# Nombre d'observations par parcelle
table(table(coleo_agri$id_parcelle))
# Vérifier les doublons parcelle-année
sum(duplicated(coleo_agri[c("id_parcelle", "year")]))
# Nombre de tontes par année
aggregate(nbre_interv ~ year, data = coleo_agri,
FUN = function(x) c(
n = length(x),
moyenne = mean(x),
variance = var(x)
))
mod_compois <- glmmTMB(
nbre_interv ~ year_c + (1 | id_parcelle),
family = compois(link = "log"),
data = coleo_agri
)
summary(mod_compois)
# Diagnostics des résidus
res_compois <- simulateResiduals(mod_compois)
plot(res_compois)
testDispersion(res_compois)
testZeroInflation(res_compois)
AIC(mod_pois2, mod_compois)
100 * (exp(fixef(mod_compois)$cond["year_c"]) - 1)
# Intervalle de confiance des coefficients
confint(mod_compois, parm = "beta_", method = "Wald")
summary(mod_compois)
# Intervalle de confiance des coefficients
confint(mod_compois, parm = "beta_", method = "Wald")
summary(mod_compois)
beta <- fixef(mod_compois)$cond["year_c"]
100 * (exp(beta) - 1)
# Test des valeurs aberrantes avec bootstrap
testOutliers(res_compois, type = "bootstrap")
# Diagnostics supplémentaires
testUniformity(res_compois)
testTemporalAutocorrelation(
res_compois,
time = coleo_agri$year,
group = coleo_agri$id_parcelle
)
summary(mod_compois)
