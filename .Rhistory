## 5.2. Plants
mod <- glmmTMB(Poaceae ~ year * clust +  (1| id_parcelle) , data=plants_year,family=nbinom1)
sim_res <- simulateResiduals(mod, n = 1000)
plot(sim_res)
testDispersion(sim_res)
testZeroInflation(sim_res) # too much zero
mod2 <- glmmTMB(Poaceae ~ year * clust + (1| id_parcelle) , data=plants_year,family=nbinom1, ziformula = ~1)
sim_res_zi <- simulateResiduals(mod2)
testZeroInflation(sim_res_zi)
testDispersion(sim_res_zi)
AIC(mod,mod2) # zero inflated model better
summary(mod2)
Anova(mod2)
tr <- emtrends(mod, ~ clust, var = "year")
test(tr)
