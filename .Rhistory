stat_compare_means(method = "kruskal.test", label.x = 2)
# Chunk 7
clust <- clusters %>%
select(id_parcelle,year,clust)
clust2 <- clust %>%
group_by(id_parcelle) %>%
mutate(
cluster = if_else(
n_distinct(clust) == 1,
as.character(first(clust)),
"mixed"
)
) %>%
ungroup() %>%
select(id_parcelle,cluster) %>%
distinct()
#write.csv(clust2,"7.clusters_intensity_practices/output/clust_for_gis.csv")
plants_year <- read.csv("7.clusters_intensity_practices/input/plants_year.csv") %>%
mutate(id_parcelle=as.character(id_parcelle)) %>%
select(-X) %>%
left_join(clust)
coleo_year <- read.csv("7.clusters_intensity_practices/input/coleo_year.csv") %>%
select(-X,-X.1) %>%
mutate(year=annee) %>%
mutate(id_parcelle=as.character(id_parcelle)) %>%
left_join(clust)
plants_year$year <- plants_year$year - mean(plants_year$year)
coleo_year$year <- coleo_year$year - mean(coleo_year$year)
mod <- glmmTMB(Bruches ~ year * clust + (1 | id_parcelle), family = nbinom2, data = coleo_year)
sim_res <- simulateResiduals(mod, n = 1000)
plot(sim_res)
testDispersion(sim_res)
testZeroInflation(sim_res)
mod2 <- glmmTMB(Bruches ~ year * clust + (1 | id_parcelle), family = nbinom2, data = coleo_year)
mod <- glmmTMB(Bruches ~ year * clust + (1 | id_parcelle), family = nbinom1, data = coleo_year)
AIC(mod,mod2)
mod <- glmmTMB(Bruches ~ year * clust + (1 | id_parcelle), family = nbinom2, data = coleo_year)
sim_res <- simulateResiduals(mod, n = 1000)
summary(mod)
mod <- glmmTMB(Buprestes ~ year * clust + (1 | id_parcelle), family = nbinom2, data = coleo_year)
sim_res <- simulateResiduals(mod, n = 1000)
plot(sim_res)
testDispersion(sim_res)
testZeroInflation(sim_res)
summary(mod)
Anova(mod)
r2(mod)
mod <- glmmTMB(Cantharides ~ year * clust + (1 | id_parcelle), family = nbinom2, data = coleo_year)
sim_res <- simulateResiduals(mod, n = 1000)
plot(sim_res)
testDispersion(sim_res)
testZeroInflation(sim_res)
summary(mod)
Anova(mod)
tr <- emtrends(mod, ~ clust, var = "year")
test(tr)
pred <- ggpredict(mod, terms = c("year", "clust"),bias_correction = TRUE)
ggplot(pred, aes(x = x, y = predicted, colour = group)) +
scale_color_manual(values=c("orange3","maroon4"))+
scale_fill_manual(values=c("orange3","maroon4")) +
geom_line(size = 1.2) +
geom_ribbon(aes(ymin = conf.low, ymax = conf.high, fill = group),
alpha = 0.1, colour = NA) +
labs(
x = "Year",
y = "Predicted soldier beetle abundances",
colour = "Cluster",
fill = "Cluster"
) +
theme(
legend.position = "top",
text = element_text(size = 12)
)+
scale_x_continuous(breaks = seq(min(coleo_year$year), max(coleo_year$year), by = 2),labels = seq(min(coleo_year$year), max(coleo_year$year), by = 2)) +
theme(axis.text=element_text(size=16),
axis.title=element_text(size=16))+
theme_graphique
