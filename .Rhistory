mod_zero_N <- glmmTMB(
azote_nul ~ year_c + (1 | id_parcelle),
family = binomial(link = "logit"),
data = coleo_agri
)
summary(mod_zero_N)
# 2. Évolution de la quantité pour les apports strictement positifs
mod_pos_N <- glmmTMB(
CoefN ~ year_c + (1 | id_parcelle),
family = Gamma(link = "log"),
data = subset(coleo_agri, CoefN > 0)
)
summary(mod_pos_N)
res_zero_N <- simulateResiduals(mod_zero_N)
plot(res_zero_N)
testUniformity(res_zero_N)
res_pos_N <- simulateResiduals(mod_pos_N)
plot(res_pos_N)
