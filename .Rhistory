select(morphog,species_coleo,total_ab) |>
mutate(morphog = factor(morphog, levels =ordre_morphog)) |>
arrange(morphog) |>
filter(morphog=!is.na)
ab_sp_scale <- ab_coleo_sp |>
group_by(species_coleo) |>
summarise(total_ab = sum(ab_coleo)) |>
ungroup() |>
left_join(corres) |>
group_by(morphog) |>
slice_max(order_by = total_ab, n = 10, with_ties = FALSE) |>
mutate(
morphog = ifelse(morphog == "Bruches", "Seed_beetles",
ifelse(morphog == "Buprestes", "Jewel_beetles",
ifelse(morphog == "Cantharides", "Soldier_beetles",
ifelse(morphog == "Carabiques", "Ground_beetles",
ifelse(morphog == "Charancons", "Weevils",
ifelse(morphog == "Chrysomeles", "Leaf_beetles",
ifelse(morphog == "Coccinelles", "Ladybugs",
ifelse(morphog == "Divers-_Petits_coleopteres_avec_antennes_en_massues", "Sap_beetles",
ifelse(morphog == "Elaterides", "Click_beetles",
ifelse(morphog == "Longicornes", "Longhorn_beetles",
ifelse(morphog == "Malachites", "Soft_wing_flower_beetles",
ifelse(morphog == "Mordelles", "Tumbling_flower_beetles",
ifelse(morphog == "Oedemerides", "False_blister_beetles",
ifelse(morphog == "Staphylins", "Rove_beetles",
morphog
))))))))))))))
) |>
select(morphog,species_coleo,total_ab) |>
mutate(morphog = factor(morphog, levels =ordre_morphog)) |>
arrange(morphog) |>
filter(!is.na(morphog))
write.csv(ab_sp_scale,"4.traits_per_morphogroups/output/ab_sp_scale.csv")
