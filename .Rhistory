library(tidyverse)
library(lme4)
library(lubridate)
library(DHARMa)
library(glmmTMB)
library(car)
library(lattice)
library(performance)
select <- dplyr::select
coleo_tot <- read.csv("2.temporal_morphogroups/input/coleo_year.csv") %>%
mutate(id_parcelle=as.character(id_parcelle))
plots_plus_sept <- coleo_tot %>%
select(id_parcelle,annee) %>%
distinct() %>%
group_by(id_parcelle) %>%
mutate(nbre_annee= n_distinct(annee)) %>%
select(id_parcelle,nbre_annee) %>%
distinct() %>%
filter(nbre_annee > 7)
coleo_year <- coleo_tot %>%
filter(id_parcelle %in% plots_plus_sept$id_parcelle)
ggplot(coleo_year, aes(x = factor(year), y = Chrysomèles)) +
geom_jitter(alpha=0.1) +
geom_boxplot(fill="pink1", alpha = 0.6) +
labs(
x = "Year",
y = "Leaf beetle abundance"
) +
theme_minimal() +
theme(
legend.position = "none"
)
ggplot(coleo_year, aes(x = factor(annee), y = Chrysomèles)) +
geom_jitter(alpha=0.1) +
geom_boxplot(fill="pink1", alpha = 0.6) +
labs(
x = "Year",
y = "Leaf beetle abundance"
) +
theme_minimal() +
theme(
legend.position = "none"
)
ggplot(coleo_year, aes(x = factor(annee), y = log1p(Chrysomèles))) +
geom_jitter(alpha=0.1) +
geom_boxplot(fill="pink1", alpha = 0.6) +
labs(
x = "Year",
y = "Leaf beetle abundance"
) +
theme_minimal() +
theme(
legend.position = "none"
)
ggplot(plants_year, aes(x = factor(year), y = Convolvulaceae)) +
geom_jitter(alpha=0.1) +
geom_boxplot(fill="pink1", alpha = 0.6) +
labs(
x = "Year",
y = "Convolvulaceae abundance"
) +
theme_minimal() +
theme(
legend.position = "none"
)
ggplot(coleo_year1, aes(x = factor(year), y = log1p(Chrysomèles))) +
geom_jitter(alpha=0.1) +
geom_boxplot(fill="pink1", alpha = 0.6) +
labs(
x = "Year",
y = "Leaf beetle abundance (clust 1)"
) +
theme_minimal() +
theme(
legend.position = "none"
)
ggplot(coleo_year2, aes(x = factor(year), y = log1p(Chrysomèles))) +
geom_jitter(alpha=0.1) +
geom_boxplot(fill="pink1", alpha = 0.6) +
labs(
x = "Year",
y = "Leaf beetle abundance (clust2)"
) +
theme_minimal() +
theme(
legend.position = "none"
)
mod2 <- glmmTMB(Convolvulaceae ~ year * clust + (1| id_parcelle) , data=plants_year,family=nbinom1, ziformula = ~1)
tr <- emtrends(mod2, ~ clust, var = "year")
test(tr)
