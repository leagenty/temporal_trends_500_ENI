# Chunk 1
library(tidyverse)
library(FactoMineR)
library(factoextra)
library(ggpubr)
library(DHARMa)
library(glmmTMB)
library(car)
library(broom.mixed)
library(emmeans)
library(ggeffects)
select <- dplyr::select
agri <- read.csv("7.clusters_intensity_practices/input/agro_data_per_field_and_year.csv") %>%
select(-X) %>%
mutate(id_parcelle=as.character(id_parcelle),
id_uniq=paste(id_parcelle,year,sep="_"))
theme_graphique<- theme(panel.border = element_blank(),
panel.grid.major = element_blank(),
panel.grid.minor = element_blank(),
panel.background = element_blank(),
axis.line = element_line(colour = "black"),
strip.background=element_rect(colour="grey",fill="white"))
# Chunk 2
agri_comp <- agri %>%
mutate(nbre_autres_pesticides = nbre_pesticides - (nbre_herbicides+nbre_insecticides)) %>%
select(id_uniq,id_parcelle,year,largeur_bordure,nbre_interv,CoefN,nbre_insecticides,nbre_herbicides,nbre_autres_pesticides,type_production,TypeCulture) %>%
drop_na() %>%
group_by(id_parcelle) %>%
mutate(nbre_annee= n_distinct(year)) %>%
ungroup() %>%
filter(nbre_annee>7) %>%
select(-nbre_annee)#%>%
#select(id_parcelle) %>%
#distinct()
# Chunk 3
agri_pca <- agri_comp %>%
filter(id_uniq!="389_2022") %>%
column_to_rownames("id_uniq") %>%
select(-id_parcelle,-year) %>%
rename(
margin_width=largeur_bordure,
nitrogen_fertilization=CoefN,
nbr_herbicides=nbre_herbicides,
nbr_interventions=nbre_interv,
nbr_fungicides=nbre_autres_pesticides,
nbr_insecticides=nbre_insecticides,
crop_type = TypeCulture,
production_type = type_production) %>%
mutate(crop_type =
ifelse(crop_type=="GrandesCultures","annual_crops",
ifelse(crop_type=="Maraichage","market_gardening","vineyard")))
names <- agri_comp %>%
filter(id_uniq!="389_2022") %>%
select(id_uniq)
res.pca <- PCA(agri_pca,quali.sup = 7:8)
fviz_pca_biplot(res.pca,
axes =c(1,2),
col.var = "black",
habillage = as.factor(agri_pca$crop_type),
label="var",
)+
scale_color_manual(values = c("orange", "seagreen","purple")) +
theme(
legend.position = "top",
text = element_text(size = 12)
)
fviz_pca_biplot(res.pca,
axes =c(1,2),
col.var = "black",
habillage = as.factor(agri_pca$production_type),
label="var") +
scale_color_manual(values = c("grey75", "green4"))+
theme(
legend.position = "top",
text = element_text(size = 12)
)
fviz_eig(res.pca)
fviz_pca_var(res.pca,
axes =c(3,4))
r <- dimdesc(res.pca, axes = c(1,2), proba = 0.05)
r$Dim.1
r$Dim.2
rr <-dimdesc(res.pca, axes = c(3,4), proba = 0.05)
dim3 <- as_tibble(rr$Dim.3$quanti)
rr$Dim.3
rr$Dim.4
# Chunk 4
cah <-HCPC(res.pca,nb.clust=2)
fviz_cluster(cah,
repel=F,
show.clust.cent=T,
palette="jco",
ggtheme=theme_minimal(),
main="Factor map")+
scale_colour_manual(values = c("orange3", "maroon4"))
id_year <- agri_comp %>%
select(id_uniq,year,id_parcelle)
clusters <- as_tibble(cah$data.clust) %>%
cbind(names) %>%
relocate(id_uniq) %>%
left_join(id_year)
summary(cah)
cah$desc.var$quanti
cah$desc.var$quali
summary(clusters)
cah$desc.axes
#write.csv(clusters,"7.clusters_intensity_practices/output/clusters.csv")
# Chunk 5
cah$desc.var$quanti
summary(clusters)
cluster1 <- clusters %>%
filter(clust==1)
summary(cluster1) # quasi que grandes cultures
# 1/28 bio
# 1514
# + CoefN, + nbre herbicides,
# - largeur bordure, - nbre interv, - nbre insecticides, -- fongicides
cluster2 <- clusters %>%
filter(clust==2) # quasi que vignes
# 1/5 bio
# 514
# +++ fongicides, + insecticides, + nbre interv, + largeur bordure
# - nbre herbicides, -- CoefN
summary(cluster2)
# Chunk 6
kruskal.test(margin_width~clust,data=clusters) # cluster 2
ggplot(aes(x=clust,y=margin_width,fill=clust),data=clusters) +
geom_boxplot() +
scale_fill_manual(values=c("orange3","maroon4"))+
labs(x="Management intensity cluster",y="Margin width (m)")+
theme(axis.text=element_text(size=16),
axis.title=element_text(size=20))+
theme_graphique +
stat_compare_means(method = "kruskal.test", label.x = 2)
kruskal.test(nbr_interventions ~clust,data=clusters) # cluster 2
ggplot(aes(x=clust,y=nbr_interventions,fill=clust),data=clusters) +
geom_boxplot() +
scale_fill_manual(values=c("orange3","maroon4"))+
labs(x="Management intensity cluster",y="Number of interventions on the margin")+
theme(axis.text=element_text(size=),
axis.title=element_text(size=20))+
theme_graphique +
theme(legend.position="none")+
stat_compare_means(method = "kruskal.test", label.x = 2)
kruskal.test(nitrogen_fertilization~clust,data=clusters) # cluster 1
ggplot(aes(x=clust,y=nitrogen_fertilization,fill=clust),data=clusters) +
geom_boxplot() +
scale_fill_manual(values=c("orange3","maroon4"))+
labs(x="Management intensity cluster",y="Dose of nitrogen fertilization")+
theme(axis.text=element_text(size=16),
axis.title=element_text(size=20))+
theme_graphique +
theme(legend.position="none")+
stat_compare_means(method = "kruskal.test", label.x = 2)
kruskal.test(nbr_insecticides~clust,data=clusters) # cluster 2$
ggplot(aes(x=clust,y=nbr_insecticides,fill=clust),data=clusters) +
geom_boxplot() +
scale_fill_manual(values=c("orange3","maroon4"))+
labs(x="Management intensity cluster",y="Number of applied insecticides")+
theme(axis.text=element_text(size=16),
axis.title=element_text(size=20))+
theme_graphique +
theme(legend.position="none")+
stat_compare_means(method = "kruskal.test", label.x = 2)
kruskal.test(nbr_herbicides~clust,data=clusters)  # cluster 1
ggplot(aes(x=clust,y=nbr_herbicides,fill=clust),data=clusters) +
geom_boxplot() +
scale_fill_manual(values=c("orange3","maroon4"))+
labs(x="Management intensity cluster",y="Number of applied herbicides")+
theme(axis.text=element_text(size=16),
axis.title=element_text(size=20))+
theme_graphique +
theme(legend.position="none")+
stat_compare_means(method = "kruskal.test", label.x = 2)
kruskal.test(nbr_fungicides~clust,data=clusters) # cluster 2
ggplot(aes(x=clust,y=nbr_fungicides,fill=clust),data=clusters) +
geom_boxplot() +
scale_fill_manual(values=c("orange3","maroon4"))+
labs(x="Management intensity cluster",y="Number of applied fungicides")+
theme(axis.text=element_text(size=16),
axis.title=element_text(size=20))+
theme_graphique +
theme(legend.position="none")+
stat_compare_means(method = "kruskal.test", label.x = 2)
mod2 <- glmmTMB(Convolvulaceae ~ year * clust + (1| id_parcelle) , data=plants_year,family=nbinom1, ziformula = ~1)
clust <- clusters %>%
select(id_parcelle,year,clust)
clust2 <- clust %>%
group_by(id_parcelle) %>%
mutate(
cluster = if_else(
n_distinct(clust) == 1,
as.character(first(clust)),
"mixed"
)
) %>%
ungroup() %>%
select(id_parcelle,cluster) %>%
distinct()
#write.csv(clust2,"7.clusters_intensity_practices/output/clust_for_gis.csv")
plants_year <- read.csv("7.clusters_intensity_practices/input/plants_year.csv") %>%
mutate(id_parcelle=as.character(id_parcelle)) %>%
select(-X) %>%
left_join(clust)
coleo_year <- read.csv("7.clusters_intensity_practices/input/coleo_year.csv") %>%
select(-X,-X.1) %>%
mutate(year=annee) %>%
mutate(id_parcelle=as.character(id_parcelle)) %>%
left_join(clust)
plants_year$year <- plants_year$year - mean(plants_year$year)
coleo_year$year <- coleo_year$year - mean(coleo_year$year)
mod2 <- glmmTMB(Convolvulaceae ~ year * clust + (1| id_parcelle) , data=plants_year,family=nbinom1, ziformula = ~1)
summary(mod2)
tr <- emtrends(mod2, ~ clust, var = "year")
test(tr)
mod <- glmmTMB(abundance  ~ year * clust + (1| id_parcelle) , data=plants_year,family=nbinom1)
r2(mod)
Anova(mod)
mod <- glmmTMB(abundance  ~ year:clust + (1| id_parcelle) , data=plants_year,family=nbinom1)
summary(mod)
Anova(mod)
r2(mod)
mod <- glmmTMB(abundance  ~ year * clust + (1| id_parcelle) , data=plants_year,family=nbinom1)
r2(mod)
mod <- glmmTMB(richness  ~ year * clust + (1| id_parcelle) , data=plants_year,family=nbinom1)
r2(mod)
r_deux <- r2(mod)
print(r_deux,digits=4)
